record(ai, "$(P):CURR_MEAS") {
    field(DESC, "FIFO Current Meas")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0)CURR_MEAS")
    field(SCAN, "Passive")
    field(PINI, "YES")
    field(PREC, "3")
    field(EGU,  "mrem/h")
    field(VAL,  "-1") # Uninitialized
}

record(ai, "$(P):OLDEST_MEAS") {
    field(DESC, "FIFO Oldest Meas")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0)OLDEST_MEAS")
    field(SCAN, "Passive")
    field(PINI, "YES")
    field(PREC, "3")
    field(EGU,  "mrem/h")
    field(VAL,  "-1") # Uninitialized
}

record(stringout, "$(PREFIX):RESET_DET"){
    field(DESC, "Program Version")
    field(DTYP, "stream")
    field(OUT,  "@lb115_channels.proto resetFifoDetAlpha('$(CHAN)') $(PORT)")
    field(SCAN, "Passive")
    field(PINI, "YES")
}

