record(stringin, "$(PREFIX):PROGRAMVERSION"){
    field(DESC, "Program Version")
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),0)PROGRAM_VER")
    field(SCAN, "I/O Intr")
}

